# 数据库配置
DATABASE_URL=postgresql://mycc:mycc_dev_password@localhost:5432/mycc_dev

# Redis 配置
REDIS_URL=redis://localhost:6379

# JWT 配置
JWT_SECRET=your_jwt_secret_change_in_production

# 服务器配置
PORT=8080
NODE_ENV=development

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxx

# Agent Runtime
# remote-claude: 现有 SSH 到 VPS 执行 claude CLI 的稳定路径
# claude-agent-sdk: 实验路径，使用官方 @anthropic-ai/claude-agent-sdk（默认安全工具集）
# e2b-claude-cli: E2B/code-server sandbox 内执行 claude CLI，并和 Remote IDE 复用同一 workspace
# e2b-claude-agent-sdk: E2B/code-server sandbox 内通过 Node bridge 执行 @anthropic-ai/claude-agent-sdk
MYCC_AGENT_RUNTIME=remote-claude

# Claude provider / CCR router
# 推荐用 MYCC_CCR_* 显式把 Claude/Anthropic 请求指向 ccr router；
# ccr router 再负责把 Anthropic/Claude 协议转换到 OpenAI-compatible provider。
# mycc 不直接把全局 OPENAI_BASE_URL/OPENAI_API_KEY 映射给 Claude，避免误用其他 OpenAI 服务凭据。
MYCC_CCR_BASE_URL=
# AUTH_TOKEN 和 API_KEY 二选一即可；mycc 只会向 Claude runtime 转发第一组命中的 credential。
MYCC_CCR_AUTH_TOKEN=
MYCC_CCR_API_KEY=
# 非 CCR 的 Claude 代理也可用这一组别名；优先级低于 MYCC_CCR_*，高于 MYCC_AGENT_SDK_* / ANTHROPIC_* / VPS_*。
MYCC_CLAUDE_BASE_URL=
MYCC_CLAUDE_AUTH_TOKEN=
MYCC_CLAUDE_API_KEY=

# Claude Agent SDK Runtime（仅 MYCC_AGENT_RUNTIME=claude-agent-sdk 时使用）
# 兼容旧配置；新接 ccr router 优先使用上面的 MYCC_CCR_*。
MYCC_AGENT_SDK_BASE_URL=
MYCC_AGENT_SDK_AUTH_TOKEN=
MYCC_AGENT_SDK_API_KEY=
MYCC_AGENT_SDK_MODEL=claude-sonnet-4-6
MYCC_AGENT_SDK_ALLOWED_TOOLS=Read,Glob,Grep
MYCC_AGENT_SDK_PERMISSION_MODE=dontAsk
MYCC_AGENT_SDK_PARTIAL_MESSAGES=false
# 默认每个 Linux 用户使用 /home/{linuxUser}/.mycc/{home,claude}
# 如运行在 E2B/容器等隔离环境，可改到专用 runtime 卷，例如 /srv/mycc/runtime
MYCC_AGENT_SDK_CONFIG_ROOT=

# 套餐配置
PLAN_FREE_TOKENS=300000
PLAN_BASIC_TOKENS=3000000
PLAN_PRO_TOKENS=12000000
PLAN_BASIC_PRICE_CNY=39
PLAN_PRO_PRICE_CNY=99

# 并发限制
MAX_CONCURRENT_USERS=20
MAX_CONCURRENT_PER_USER=1

# VPS SSH 配置
VPS_HOST=your-vps-ip
VPS_SSH_PORT=22
VPS_SSH_USER=root
VPS_SSH_KEY_PATH=/path/to/ssh/private/key
VPS_SSH_MAX_CONNECTIONS=5
VPS_SSH_READY_TIMEOUT_MS=30000
VPS_SSH_FORCE_IPV4=true
VPS_SSH_KEEPALIVE_INTERVAL_MS=10000
VPS_SSH_KEEPALIVE_COUNT_MAX=3

# 文件化 identity/soul 存储目录（可选）
# 默认: <backend cwd>/runtime/chat-soul
CHAT_SOUL_DIR=

# 自动化调度器（OpenClaw 对齐：后端内建 cron 调度）
AUTOMATIONS_SCHEDULER_ENABLED=true
AUTOMATIONS_SCHEDULER_TICK_MS=60000
AUTOMATIONS_SCHEDULER_MAX_USERS_PER_TICK=500
AUTOMATIONS_SCHEDULER_MAX_CONCURRENT_RUNS=8

# 工作区命令执行接口（默认关闭，且仅 admin 可用）
WORKSPACE_EXEC_ENABLED=false

# Remote IDE / code-server（POC 骨架，默认关闭）
# disabled: 不开放 IDE 能力
# e2b: 计划使用 E2B sandbox + code-server，通过 mycc 后端反向代理访问
MYCC_IDE_PROVIDER=disabled
MYCC_IDE_PORT=18080
MYCC_IDE_SESSION_TTL_SECONDS=3600
# Must use the E2B SDK format: e2b_<hex>. MYCC_E2B_API_KEY wins over E2B_API_KEY.
MYCC_E2B_API_KEY=
E2B_API_KEY=
MYCC_E2B_TEMPLATE=mycc-code-server-dev
# 产品路径必须保持 false：E2B public host 只允许 mycc 后端携带 traffic token 访问
MYCC_E2B_ALLOW_PUBLIC_TRAFFIC=false
# E2B Agent SDK bridge：默认执行 cd /opt/mycc-agent-runtime && node bridge.mjs。
# template 需要预装 @anthropic-ai/claude-agent-sdk 和 /opt/mycc-agent-runtime/bridge.mjs。
MYCC_E2B_AGENT_SDK_BRIDGE_COMMAND=
MYCC_E2B_AGENT_SDK_MODEL=claude-sonnet-4-6
MYCC_E2B_AGENT_SDK_TIMEOUT_MS=600000
