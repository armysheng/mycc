{
  "name": "mycc-backend",
  "version": "1.0.0",
  "description": "MyCC 商业化后端服务",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/sync-skills-catalog.mjs",
    "start": "node dist/index.js",
    "test": "vitest",
    "backfill:id-soul": "tsx scripts/backfill-legacy-id-soul.ts",
    "cleanup:ide-sessions": "tsx scripts/cleanup-expired-ide-sessions.ts",
    "doctor:e2b-agent": "tsx scripts/doctor-e2b-agent.ts",
    "smoke:e2b-ide": "tsx scripts/smoke-e2b-ide.ts",
    "smoke:e2b-agent-workspace": "tsx scripts/smoke-e2b-agent-workspace.ts",
    "smoke:e2b-agent-sdk-workspace": "MYCC_SMOKE_E2B_AGENT_RUNTIME=e2b-claude-agent-sdk tsx scripts/smoke-e2b-agent-workspace.ts"
  },
  "keywords": [
    "mycc",
    "claude",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.158",
    "@anthropic-ai/claude-code": "^2.1.158",
    "@fastify/cors": "^9.0.1",
    "@types/http-proxy": "^1.17.17",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "e2b": "^2.27.0",
    "fastify": "^4.26.2",
    "gray-matter": "^4.0.3",
    "http-proxy": "^1.18.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.2",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  }
}
